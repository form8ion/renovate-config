{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["nvm"],
      "postUpgradeTasks": {
        "commands": ["mise lock node"],
        "fileFilters": ["mise.lock"],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["terraform-version"],
      "postUpgradeTasks": {
        "commands": ["mise lock terraform"],
        "fileFilters": ["mise.lock"],
        "executionMode": "branch"
      }
    }
  ]
}
